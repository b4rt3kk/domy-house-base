<?php
/* @var $paginator \Base\Paginator */
$totalPages = max(1, (int) $paginator->getTotalPages());
$currentPage = max(1, min($totalPages, (int) $paginator->getCurrentPage()));
$firstPage = max(1, min($totalPages, (int) $paginator->getFirstPageInRange()));
$lastPage = max($firstPage, min($totalPages, (int) $paginator->getLastPageInRange()));
$totalResults = $paginator->getTotalResults();
$loadTime = $paginator->getPageLoadTimeMs();
$perPageOptions = $paginator->getPerPageOptions();
$perPage = $paginator->getItemsPerPage();
$columnOptions = $paginator->getColumnOptions();
$visibleHeaders = $columnOptions ? $paginator->getVisibleHeaders() : [];
$navigationId = uniqid('paginator-navigation-');
?>
<nav class="navbar bg-body-tertiary mb-3 base-paginator-navigation" aria-label="Nawigacja stron wyników">
    <div class="container-fluid flex-column flex-lg-row w-100 base-paginator-layout" data-floating-label="off">
        <!-- numer strony -->
        <div class="d-flex justify-content-lg-start justify-content-center flex-grow-1 base-paginator-pages">
            <a class="btn btn-outline-primary mr-1 <?php echo $currentPage <= 1 ? 'disabled' : null; ?>" href="<?php echo $this->url(null, [], ['query' => ['page' => max(1, $currentPage - 1)]], true); ?>" aria-label="Previous">
                <span aria-hidden="true">&laquo;</span>
                <span class="sr-only">Previous</span>
            </a>
            
            <?php for ($i = $firstPage; $i <= $lastPage; $i++) : ?>
                <a class="btn mr-1 <?php echo ($currentPage == $i ? 'btn-primary' : 'btn-outline-primary') ?>" href="<?php echo $this->url(null, [], ['query' => ['page' => $i]], true); ?>"><?php echo $i; ?></a>
            <?php endfor; ?>
            
            <a class="btn btn-outline-primary <?php echo $currentPage >= $totalPages ? 'disabled' : null; ?>" href="<?php echo $this->url(null, [], ['query' => ['page' => min($totalPages, $currentPage + 1)]], true); ?>" aria-label="Next">
                <span class="sr-only">Next</span>
                <span aria-hidden="true">&raquo;</span>
            </a>
        </div>
        
        <div class="base-paginator-mobile d-none">
            <div class="base-paginator-page-field">
            <label for="<?= $navigationId ?>-page">Strona</label>
            <select id="<?= $navigationId ?>-page" class="form-control base-paginator-page" aria-label="Wybierz stronę">
                <?php for ($page = 1; $page <= $totalPages; $page++): ?>
                    <option value="<?= $this->escapeHtmlAttr($this->url(null, [], ['query' => ['page' => $page]], true)) ?>" <?= $page == $currentPage ? 'selected' : '' ?>><?= $page ?> z <?= $totalPages ?></option>
                <?php endfor; ?>
            </select>
            </div>
            <div class="base-paginator-shortcuts" role="group" aria-label="Przejdź do strony">
                <?php foreach ([
                    [1, 'Pierwsza strona', '«', $currentPage <= 1],
                    [max(1, $currentPage - 1), 'Poprzednia strona', '‹', $currentPage <= 1],
                    [min($totalPages, $currentPage + 1), 'Następna strona', '›', $currentPage >= $totalPages],
                    [$totalPages, 'Ostatnia strona', '»', $currentPage >= $totalPages],
                ] as [$page, $label, $symbol, $disabled]): ?>
                    <a class="btn btn-outline-primary<?= $disabled ? ' disabled' : '' ?>" aria-label="<?= $label ?>" title="<?= $label ?>" <?= $disabled ? 'aria-disabled="true" tabindex="-1"' : '' ?> href="<?= $this->escapeHtmlAttr($this->url(null, [], ['query' => ['page' => $page]], true)) ?>"><?= $symbol ?></a>
                <?php endforeach; ?>
            </div>
        </div>

        <div class="d-flex justify-content-center flex-grow-1 base-paginator-position">
            <span class="navbar-text">Strona <strong><?php echo $currentPage; ?></strong>  z <strong><?php echo $totalPages; ?></strong></span>
        </div>
      
        <div class="d-flex justify-content-center flex-grow-1 form-floating base-paginator-size">
                <select id="<?= $navigationId ?>-size" name="items_per_page" class="form-control text-right" aria-label="Wyników na stronę">
                <?php foreach ($perPageOptions as $option) : ?>
                    <option value="<?php echo $option; ?>" <?php echo ($perPage == $option ? 'selected' : null); ?>><?php echo $option; ?></option>
                <?php endforeach; ?>
                </select>
                <label for="<?= $navigationId ?>-size"><span class="base-paginator-size-label">Wyników na stronę</span><span class="base-paginator-size-short-label" hidden>Na stronie</span></label>
        </div>
        
        <div class="d-flex justify-content-center flex-grow-1 base-paginator-results">
            <span class="navbar-text">Wyników <strong><i class="fas fa-hashtag"></i><?php echo $totalResults; ?></strong></span>
        </div>
        
        <div class="d-flex justify-content-center justify-content-lg-end flex-grow-1 base-paginator-duration">
            <span class="navbar-text"><strong><i class="far fa-clock"></i></strong> <?php echo number_format($loadTime, 4); ?> s</span>
        </div>
    </div>
    <?php if ($columnOptions): ?>
    <div class="accordion base-paginator-advanced w-100">
    <div class="accordion-item">
    <h2 class="accordion-header">
        <button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#<?= $navigationId ?>-advanced" aria-expanded="false" aria-controls="<?= $navigationId ?>-advanced">Zaawansowane</button>
    </h2>
    <div id="<?= $navigationId ?>-advanced" class="accordion-collapse collapse">
    <div class="accordion-body" data-floating-label="on">
    <div class="base-paginator-columns" data-column-controls data-columns-token="<?= $this->escapeHtmlAttr($paginator->getColumnSelectionToken()) ?>">
        <label for="<?= $navigationId ?>-columns">Wyświetlane kolumny</label>
        <select id="<?= $navigationId ?>-columns" class="selectpicker-select-filter" multiple data-paginator-columns data-actions-box="true" data-selected-text-format="count > 2" title="Brak wybranych kolumn">
            <?php foreach ($columnOptions as $name => $column): ?>
                <option value="<?= $this->escapeHtmlAttr($name) ?>" <?= in_array($name, $visibleHeaders, true) ? 'selected' : '' ?>><?= $this->escapeHtml(strip_tags($column['label'])) ?></option>
            <?php endforeach; ?>
        </select>
        <div class="base-paginator-advanced-actions">
        <button type="button" class="btn btn-outline-primary" data-columns-apply>Zastosuj</button>
        <button type="button" class="btn btn-outline-secondary" data-columns-reset>Wyczyść</button>
        </div>
        <p class="text-danger mb-0" role="alert" hidden>Nie udało się zapisać kolumn. Spróbuj ponownie.</p>
    </div>
    </div>
    </div>
    </div>
    </div>
    <?php endif; ?>
</nav>

