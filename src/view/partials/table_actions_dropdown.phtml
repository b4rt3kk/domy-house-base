    <button id="<?= $this->escapeHtmlAttr($id) ?>" class="btn btn-outline-primary dropdown-toggle" type="button"
            data-bs-toggle="dropdown" data-bs-config='{"popperConfig":{"strategy":"fixed"}}' aria-expanded="false" aria-label="Akcje rekordu">Akcje</button>
    <div class="dropdown-menu dropdown-menu-end" aria-labelledby="<?= $this->escapeHtmlAttr($id) ?>"><?= $content ?></div>
</div>
