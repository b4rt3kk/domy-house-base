<?php
/* @var $data \Laminas\Db\ResultSet\ResultSet */
$prototype = $data->getArrayObjectPrototype();
/* @var $prototype \Base\Db\Table\AbstractEntity */

$index = isset($index) ? $index : 1;
$headersMapping = $prototype->getHeadersMapping();
$rowActions = $prototype->getRowActions();
$rowDictionaries = $prototype->getDictionaries();
$sort = isset($sort) ? $sort : [];
$ajaxUrl = isset($ajax_url) ? $ajax_url : null;
$ajaxParams = isset($ajax_params) ? $ajax_params : json_encode([]);
$tableId = isset($table_id) ? $table_id : uniqid();

$hasActions = !empty($rowActions) || !empty($table_actions_partial);
if (empty($table_actions_partial)) {
    $table_actions_partial = $prototype->getActionsPartial();
}

$options = $table_options ?? [];
$showIndex = $options['showIndex'] ?? true;
$cellPartials = $options['cellPartials'] ?? [];
$context = isset($options['context']) ? ($options['context'])($this, $headers) : [];
$dictionaries = [];
$massActions = [];
if (($allow_mass_actions ?? true) && $prototype->getAllowMassActions()) {
    $rbac = $this->serviceManager()->get(\Base\Services\Rbac\RbacManager::class);
    foreach ($prototype->getMassActions() as $key => $action) {
        $hasRecordPermission = array_filter($action['recordPrivileges'] ?? [], static fn ($privilege) => $rbac->isGranted(null, $privilege));
        if (!empty($action['privilege']) && $rbac->isGranted(null, $action['privilege']) && $hasRecordPermission) {
            $massActions[$key] = $action;
        }
    }
}
$massAllowed = static function ($row, array $action) use (&$rbac): bool {
    foreach ($action['recordPrivileges'] ?? [] as $privilege) {
        if ($rbac->isGranted(null, $privilege, $row->getData())) return true;
    }
    return false;
};

foreach ($rowDictionaries as $key => $rowDictionary) {
    if (isset($cellPartials[$key]) || !in_array($key, $headers, true)) {
        continue;
    }
    $dictionary = clone $this->serviceManager()->get(\Base\Dictionary::class);
    $dictionary->init();
    
    /* @var $dictionary \Base\Dictionary */
    if (!empty($rowDictionary['name'])) {
        $dictionary->setDictionaryName($rowDictionary['name']);
    }
    
    if (!empty($rowDictionary['id'])) {
        $dictionary->setIdKey($rowDictionary['id']);
    }
    
    if (!empty($rowDictionary['modelName'])) {
        $dictionary->setModelName($rowDictionary['modelName']);
    }
    
    if (!empty($rowDictionary['nameFields'])) {
        $dictionary->setNameFields($rowDictionary['nameFields']);
    }
    
    if (!empty($rowDictionary['where'])) {
        $dictionary->setWhere($rowDictionary['where']);
    }
    
    if (!empty($rowDictionary['separator'])) {
        $dictionary->setSeparator($rowDictionary['separator']);
    }
    
    $dictionaries[$key] = $dictionary->getDictionary();
}

if ($responsive) {
    echo '<div class="table-responsive table-responsive-xxl">';
}

echo '<table class="' . $this->escapeHtmlAttr('table ' . ($options['class'] ?? '')) . '" id="' . $tableId . '">';
echo '<thead class="table-light">';
echo '<tr>';
if ($massActions) {
    echo '<th hidden data-mass-cell class="base-mass-cell text-center align-middle"><label class="base-mass-choice"><input type="checkbox" class="form-check-input" data-mass-all aria-label="Zaznacz wszystkie dostępne wiersze na tej stronie"></label></th>';
}
if ($showIndex) echo '<th class="fw-bold">#</th>';

foreach ($headers as $header) {
    echo '<th class="fw-bold text-nowrap ' . (!empty($headersMapping[$header]['sortable']) ? 'sortable' : null) . '" data-column_name="' . $header . '">';
    
    if (!empty($headersMapping[$header]['sortable'])) {
        echo '<a href="#"> '; 
        
        if (array_key_exists($header, $sort) && $sort[$header] === 'ASC') {
            echo '<i class="fa fa-sort-up"></i> ';
        } else if (array_key_exists($header, $sort) && $sort[$header] === 'DESC') {
            echo '<i class="fa fa-sort-down"></i> ';
        } else {
            echo '<i class="fa fa-sort"></i> ';
        }
        
        echo $headersMapping[$header]['title'] . ' ';
        
        echo '</a>';
    } else {
        echo $headersMapping[$header]['title'];
    }
    
    echo '</th>';
}

if ($hasActions) {
    echo '<th class="fw-bold text-nowrap">' . $this->escapeHtml($options['actionsLabel'] ?? 'Actions') . '</th>';
}

echo '</tr>';
echo '</thead>';

echo '<tbody>';

foreach ($data as $row) {
    $rowClass = isset($options['rowClass']) ? ($options['rowClass'])($row) : '';
    echo '<tr class="' . $this->escapeHtmlAttr($rowClass) . '">';
    if ($massActions) {
        $allowed = array_keys(array_filter($massActions, static fn ($action) => $massAllowed($row, $action)));
        echo '<td hidden data-mass-cell class="base-mass-cell text-center align-middle"><label class="base-mass-choice"><input type="checkbox" class="form-check-input" data-mass-row value="'
            . $this->escapeHtmlAttr((string) $row->id) . '" aria-label="Zaznacz rekord ' . $this->escapeHtmlAttr((string) $row->id)
            . '" data-mass-allowed="' . $this->escapeHtmlAttr(json_encode($allowed)) . '"' . (!$allowed ? ' disabled' : '') . '></label></td>';
    }
    if ($showIndex) echo '<td><strong>' . ($index++) . '</strong></td>';
    
    foreach ($headers as $header) {
        $cellPartial = $cellPartials[$header] ?? null;
        $value = $row->{$header};
        $class = null;
        
        if (!empty($dictionaries[$header][$row->{$header}])) {
            $value = $dictionaries[$header][$row->{$header}];
        }
        
        if (!$cellPartial && !empty($headersMapping[$header]['format'])) {
            $value = $this->format()->format($headersMapping[$header]['format'], $value);
        }
        
        if (!empty($headersMapping[$header]['class'])) {
            $class = $headersMapping[$header]['class'];
        }
        
        if (in_array($headersMapping[$header]['format'] ?? null, [
            \Base\View\Helper\Format::FORMAT_DATE, \Base\View\Helper\Format::FORMAT_DATE_TIME,
            \Base\View\Helper\Format::FORMAT_DATE_INTL, \Base\View\Helper\Format::FORMAT_DATE_TIME_INTL,
            \Base\View\Helper\Format::FORMAT_TIME_LEFT,
        ], true)) {
            $class = trim(($class ?? '') . ' text-nowrap');
        }
        echo '<td class="' . $class . '">';
        if ($cellPartial) {
            echo $this->partial($cellPartial, ['row' => $row, 'header' => $header, 'value' => $value, 'context' => $context]);
        } else {
            echo !empty($headersMapping[$header]['escape']) ? $this->escapeHtml((string) $value) : $value;
        }
        echo '</td>';
    }
    
    if ($hasActions) {
        echo '<td class="text-nowrap">';
        echo $this->partial($table_actions_partial, ['actions' => $rowActions, 'row' => $row]);
        echo '</td>';
    }
    
    echo '</tr>';
}

echo '</tbody>';

echo '</table>';

if ($responsive) {
    echo '</div>';
}

if ($massActions) {
    echo '<div class="base-mass-actions bg-body-tertiary p-3 mb-3" data-mass-controls="' . $this->escapeHtmlAttr($tableId) . '">';
    echo '<button type="button" class="btn btn-outline-primary p-3" data-mass-toggle aria-expanded="false" aria-controls="' . $this->escapeHtmlAttr($tableId) . '">Akcje masowe</button>';
    echo '<div hidden data-mass-panel><p class="mt-3" data-mass-count aria-live="polite">Zaznaczono: 0</p>';
    echo '<p hidden data-mass-error class="alert alert-danger" role="alert" tabindex="-1"></p>';
    foreach ($massActions as $key => $action) {
        $url = $this->url($action['route'], ($action['params'] ?? []) + ['action' => $action['action']], ['query' => $action['query'] ?? []]);
        echo '<button type="button" class="btn btn-outline-primary p-3" data-mass-action="' . $this->escapeHtmlAttr((string) $key)
            . '" data-mass-url="' . $this->escapeHtmlAttr($url) . '">' . $this->escapeHtml($action['label']) . '</button>';
    }
    echo '</div></div>';
}

// Encode JS literals independently from HTML, including quotes and closing script tags.
$ajaxUrlJs = json_encode($ajaxUrl, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
$ajaxParamsJs = json_encode($ajaxParams, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
$tableIdJs = json_encode($tableId, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_THROW_ON_ERROR);
$this->inlineScript()->captureStart();
echo <<<"JS"
(() => {
    const table = document.getElementById({$tableIdJs});
    const controls = Array.from(document.querySelectorAll('[data-mass-controls]')).find(el => el.dataset.massControls === {$tableIdJs});
    if (controls) {
        const toggle = controls.querySelector('[data-mass-toggle]');
        const panel = controls.querySelector('[data-mass-panel]');
        const all = table.querySelector('[data-mass-all]');
        const rows = Array.from(table.querySelectorAll('[data-mass-row]:not(:disabled)'));
        const error = controls.querySelector('[data-mass-error]');
        const selected = () => rows.filter(row => row.checked);
        const sync = () => {
            const count = selected().length;
            all.checked = rows.length > 0 && count === rows.length;
            all.indeterminate = count > 0 && count < rows.length;
            all.disabled = !rows.length;
            controls.querySelector('[data-mass-count]').textContent = 'Zaznaczono: ' + count;
            error.hidden = true;
        };
        toggle.addEventListener('click', () => {
            const open = toggle.getAttribute('aria-expanded') !== 'true';
            toggle.setAttribute('aria-expanded', String(open));
            table.querySelectorAll('[data-mass-cell]').forEach(cell => cell.hidden = !open);
            panel.hidden = !open;
            if (!open) rows.forEach(row => row.checked = false);
            sync();
        });
        all.addEventListener('change', () => { rows.forEach(row => row.checked = all.checked); sync(); });
        rows.forEach(row => row.addEventListener('change', sync));
        controls.querySelectorAll('[data-mass-action]').forEach(button => button.addEventListener('click', () => {
            const checked = selected();
            let message = checked.length ? '' : 'Wybierz co najmniej jeden rekord.';
            if (checked.some(row => !JSON.parse(row.dataset.massAllowed).map(String).includes(button.dataset.massAction))) {
                message = 'Ta akcja nie jest dostępna dla wszystkich zaznaczonych rekordów.';
            }
            if (message) { error.textContent = message; error.hidden = false; error.focus(); return; }
            const url = new URL(button.dataset.massUrl, window.location.href);
            url.searchParams.set('ids', checked.map(row => row.value).join(','));
            window.location.assign(url.href);
        }));
        sync();
    }
    const ajaxUrl = {$ajaxUrlJs};
    const ajaxParams = JSON.parse({$ajaxParamsJs});

    $('#{$tableId}').find('thead th.sortable a').each(function() {
        $(this).on("click", function() {
           let columnName = $(this).closest('th').attr('data-column_name');
           let data = ajaxParams;
    
           data['columnName'] = columnName;
    
           $.ajax({
               url: ajaxUrl,
               type: "POST",
               data: data,
               success: function(response) {
                   window.location.reload(true);
               }
           });
    
           return false;
        });
    });
})();
JS;
    $this->inlineScript()->captureEnd();
